{UTF-8}
"Jumlah Perusahaan yang memathui Norma Ketenagakerjaan (Unit)"=
	"Jumlah Usaha Besar Korporasi (Unit)"+"Jumlah Usaha Menengah (Unit)"
	~	Unit
	~	@output directorate=NAKER indicator=45
	|

Persentase PPU Jamsos Naker=
	"Penyerapan Tenaga Kerja Formal (Pop)"
	~	Pop
	~	@output directorate=NAKER indicator=50
	|

"Cakupan Jamsos Naker (Pop)"=
	"Penyerapan Tenaga Kerja Formal (Pop)"+0.2*"Penyerapan Tenaga Kerja Informal (Pop)"
	~	Pop
	~	@output directorate=KJS indicator=28
	|

Asumsi Kekayaan Kelas Atas dan Menengah=
	500000
	~	dmnl
	~		|

Asumsi Kekayaan Kelas Miskin dan Ekstrem=
	200000
	~	dmnl
	~		|

Jumlah Usaha Mikro dan Kecil=
	0.7*"Jumlah Working Poor (Pop)"
	~	Unit
	~	@output directorate=KUMKM indicator=52
	|

Laju Pertumbuhan PDB per Tenaga Kerja=
	"Jumlah PDB (Rp)"/("Penyerapan Tenaga Kerja Formal (Pop)"+"Penyerapan Tenaga Kerja Informal (Pop)"\
		)
	~	Rp/Pop
	~	@output directorate=Naker indicator=41
	|

"Jumlah PDB (Rp)"=
	"Jumlah PDB dari Lapangan Usaha Formal (Rp)"+"Jumlah PDB dari Lapangan Usaha Nonformal (Rp)"
	~	Rp
	~		|

"Jumlah PDB dari Lapangan Usaha Formal (Rp)"=
	"Rata-Rata PDB/Kapita Lapangan Usaha Formal (Rp/Pop)"*"Penyerapan Tenaga Kerja Formal (Pop)"
	~	Rp
	~		|

"Jumlah PDB dari Lapangan Usaha Nonformal (Rp)"=
	"Rata-rata PDB/Kapita Lapangan Usaha Nonformal (Rp/Pop)"*"Penyerapan Tenaga Kerja Informal (Pop)"
	~	Rp
	~		|

"Jumlah Penduduk Initial (Pop)"=
	10000
	~	Pop
	~	@input min=0 max=100000 step=5
	|

"Rasio Kewirausahaan (Unit/Pop)"=
	10
	~	Unit/Pop
	~	@input min=0 max=100 step=5
	|

"Konversi 6 (Unit/Pop)"=
	10
	~	Unit/Pop
	~		|

"Konversi 7 (Unit/Pop)"=
	10
	~	Unit/Pop
	~		|

"Konversi 8 (Unit/Pop)"=
	10
	~	Unit/Pop
	~		|

"Jumlah Start Up (Unit)"=
	("Jumlah Kelas Atas (Pop)"+"Jumlah Kelas Menengah (Pop)")*"Rasio Kewirausahaan (Unit/Pop)"
	~	Unit
	~		|

"Jumlah Lapangan Kerja dari Startup (Pop)"=
	"Jumlah Start Up (Unit)"*"Konversi 6 (Unit/Pop)"
	~	Pop
	~		|

"Jumlah Lapangan Kerja dari Usaha Besar/Korporasi (Pop)"=
	"Konversi 8 (Unit/Pop)"*"Jumlah Usaha Besar Korporasi (Unit)"
	~	Pop
	~		|

"Jumlah Lapangan Kerja dari Usaha Menengah (Pop)"=
	"Jumlah Usaha Menengah (Unit)"*"Konversi 7 (Unit/Pop)"
	~	Pop
	~		|

"Jumlah Usaha Menengah (Unit)"=
	"Rasio Kewirausahaan (Unit/Pop)"*"Jumlah Kelas Menengah (Pop)"
	~	Unit
	~		|

Rasio Gini=
	("Jumlah Kelas Menengah (Pop)"+"Jumlah Kelas Atas (Pop)")*Asumsi Kekayaan Kelas Atas dan Menengah\
		/(("Jumlah Kelas Menengah (Pop)"+"Jumlah Kelas Menengah (Pop)")*Asumsi Kekayaan Kelas Atas dan Menengah\
		+Jumlah Penduduk Miskin*Asumsi Kekayaan Kelas Miskin dan Ekstrem)
	~	dmnl
	~	@output directorate=KJS indicator=24
	|

"Rata-Rata PDB/Kapita Lapangan Usaha Formal (Rp/Pop)"=
	0.305
	~	Rp/Pop
	~		|

"Jumlah Usaha Besar Korporasi (Unit)"=
	"Jumlah Kelas Atas (Pop)"*"Rasio Kewirausahaan (Unit/Pop)"
	~	Unit
	~		|

"Mobilitas Penduduk Penyandang Disabilitas (dmnl)"=
	"Jumlah Penyandang Disabilitas bekerja di sektor formal (Pop)"/"Jumlah Penduduk Usia Kerja (Pop)"
	~	dmnl
	~	@output directorate=PKKS indicator=4
	|

"Jumlah Penduduk Total (Pop)"= INTEG (
	"Penambahan Jumlah Penduduk (Pop)"-"Pengurangan Jumlah Penduduk (Pop)",
		"Jumlah Penduduk Initial (Pop)")
	~	Pop
	~		|

"Rata-rata PDB/Kapita Lapangan Usaha Nonformal (Rp/Pop)"=
	0.7
	~	Rp/Pop
	~		|

"Cost of Compliance/Regulation + Investment Impediment +Uncertainty + Corruption (dmnl)"\
		=
	0.1
	~	dmnl
	~	@input min=0 max=1 step=5
	|

"Efek Akses dan Literasi Keuangan, Investasi, permodalan, networking (dmnl)"=
	0.1
	~	dmnl
	~		|

"Fertilitas (dmnl)"=
	2.1
	~	dmnl
	~	@input min=1 max=3 step=5
	|

"Inflasi (dmnl)"=
	0.05
	~	dmnl
	~		|

"Investasi High Value Added Manufacturing (Rp)"=
	500
	~	Rp
	~	@input step=5
	|

"Investasi High Value Added Service (Rp)"=
	500
	~	Rp
	~	@input step=5
	|

"Investasi Low Value Added Manufacturing (Rp)"=
	500
	~	Rp
	~	@input step=5
	|

"Investasi Low Value Added Service (Rp)"=
	500
	~	Rp
	~	@input step=5
	|

"Investasi Sektor Primer (Rp)"=
	500
	~	Rp
	~	@input step=5
	|

"Jumlah Kelas Atas (Pop)"=
	"Jumlah Kelas Menengah (Pop)"*"Efek Akses dan Literasi Keuangan, Investasi, permodalan, networking (dmnl)"
	~	Pop
	~		|

"Jumlah Kelas Menengah (Pop)"= INTEG (
	"Penambahan Jumlah Kelas Menengah (Pop)"-"Pengurangan Jumlah Kelas Menengah (Pop)",
		0)
	~	Pop
	~	@output directorate=KJS indicator=25
	|

"Jumlah Lapangan Kerja High Value Added Manufacturing (Pop)"=
	"Konversi 1 (Pop/Rp)"*"Investasi High Value Added Manufacturing (Rp)"
	~	Pop
	~		|

"Jumlah Lapangan Kerja High Value Added Service (Pop)"=
	"Konversi 2 (Pop/Rp)"*"Investasi High Value Added Service (Rp)"
	~	Pop
	~		|

"Jumlah Lapangan Kerja Low Value Added Manufacturing (Pop)"=
	"Konversi 4 (Pop/Rp)"*"Investasi Low Value Added Manufacturing (Rp)"
	~	Pop
	~		|

"Jumlah Lapangan Kerja Low Value Added Primary (Pop)"=
	"Konversi 3 (Pop/Rp)"*"Investasi Sektor Primer (Rp)"
	~	Pop
	~		|

"Jumlah Lapangan Kerja Low Value Added Service (Pop)"=
	"Konversi 5 (Pop/Rp)"+ "Investasi Low Value Added Service (Rp)" + 3.3*"Jumlah Kelas Menengah (Pop)"
	~	Pop
	~		|

"Jumlah Lapangan Usaha Formal (Pop)"=
	("Jumlah Lapangan Kerja High Value Added Manufacturing (Pop)"+"Jumlah Lapangan Kerja High Value Added Service (Pop)"\
		+"Jumlah Lapangan Kerja dari Usaha Menengah (Pop)"+"Jumlah Lapangan Kerja dari Usaha Besar/Korporasi (Pop)"\
		+"Jumlah Lapangan Kerja dari Startup (Pop)")*(1-"Cost of Compliance/Regulation + Investment Impediment +Uncertainty + Corruption (dmnl)"\
		)
	~	Pop
	~	@output directorate=NAKER indicator=43
	|

"Jumlah Lapangan Usaha Nonformal (Pop)"=
	("Jumlah Lapangan Kerja Low Value Added Primary (Pop)"+"Jumlah Lapangan Kerja Low Value Added Manufacturing (Pop)"\
		+"Jumlah Lapangan Kerja Low Value Added Service (Pop)")*(1-"Cost of Compliance/Regulation + Investment Impediment +Uncertainty + Corruption (dmnl)"\
		)
	~	Pop
	~		|

Jumlah Penduduk Miskin=
	"Jumlah Pengangguran (Pop)"+"Jumlah Working Poor (Pop)"
	~	Pop
	~	@output directorate=PKKS indicator=1
	|

Jumlah Penduduk Miskin Ekstrem=
	0.05 * Jumlah Penduduk Miskin
	~	Pop
	~	@output directorate=PKKS indicator=2
	|

"Jumlah Penduduk Usia 0-15 Tahun (Pop)"=
	("Proporsi Usia 0-15 Tahun Awal (dmnl)"+"Rate Perubahan Proporsi Usia 0-15 Tahun (dmnl)"\
		)*"Jumlah Penduduk Total (Pop)"
	~	Pop
	~		|

"Jumlah Penduduk Usia Kerja (Pop)"=
	("Proporsi Usia Kerja Awal (dmnl)"+"Rate Perubahan Proporsi Usia Kerja (dmnl)")*"Jumlah Penduduk Total (Pop)"
	~	Pop
	~		|

"Jumlah Pengangguran (Pop)"=
	("Jumlah Tenaga Kerja Keterampilan Rendah (Pop)"+"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"\
		+"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)")-("Penyerapan Tenaga Kerja Formal (Pop)"\
		+"Penyerapan Tenaga Kerja Informal (Pop)")
	~	Pop
	~	@output directorate=NAKER indicator=32
	|

"Jumlah Penyandang Disabilitas bekerja di sektor formal (Pop)"=
	(8.5/100)*"Jumlah Penduduk Usia Kerja (Pop)"/"Jumlah Lapangan Usaha Formal (Pop)"
	~	dmnl
	~	@output directorate=PKKS indicator=14
	|

"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"=
	("Proporsi Lulusan Pendidikan Menengah Awal (dmnl)"+"Rate Perubahan Proporsi Lulusan Pendidikan Menengah (dmnl)"\
		)*"Jumlah Penduduk Usia Kerja (Pop)"
	~	
	~		|

"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)"=
	("Proporsi Lulusan Pendidikan Dasar Awal (dmnl)"+"Rate Perubahan Proporsi Lulusan Pendidikan Dasar (Dmnl)"\
		)*"Jumlah Penduduk Usia Kerja (Pop)"
	~	Pop
	~		|

"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"=
	("Proporsi Lulusan Pendidikan Tinggi Awal (dmnl)"+"Rate Perubahan Proporsi Lulusan Pendidikan Tinggi (dmnl)"\
		)*"Jumlah Penduduk Usia Kerja (Pop)"
	~	Pop
	~		|

"Jumlah Working Poor (Pop)"=
	"Penyerapan Tenaga Kerja Informal (Pop)"+"Pengurangan Jumlah Kelas Menengah (Pop)"
	~	Pop
	~		|

