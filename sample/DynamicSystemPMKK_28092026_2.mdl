	~	Pop/Rp
	~		|

"Mortalitias (dmnl)"=
	2.1
	~	dmnl
	~	@input min=1 max=3 step=5
	|

"Penambahan Jumlah Kelas Menengah (Pop)"=
	"Jumlah Lapangan Usaha Formal (Pop)"
	~	Pop
	~		|

"Penambahan Jumlah Penduduk (Pop)"=
	"Jumlah Penduduk Total (Pop)"*"Fertilitas (dmnl)"
	~	Pop
	~		|

"Pengurangan Jumlah Kelas Menengah (Pop)"=
	"Jumlah Kelas Menengah (Pop)"*"Inflasi (dmnl)"
	~	Pop
	~		|

"Pengurangan Jumlah Penduduk (Pop)"=
	"Jumlah Penduduk Total (Pop)"*"Mortalitias (dmnl)"
	~	Pop
	~		|

"Penyerapan Tenaga Kerja Formal (Pop)"=
	IF THEN ELSE( "Jumlah Lapangan Usaha Formal (Pop)">0.9*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"\
		+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"+0.1*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)"\
		 , 0.9*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"\
		+0.1*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)" , "Jumlah Lapangan Usaha Formal (Pop)"\
		 )
	~	Pop
	~	@output directorate=Naker indicator=42
	|

"Penyerapan Tenaga Kerja Informal (Pop)"=
	IF THEN ELSE( "Jumlah Lapangan Usaha Nonformal (Pop)">0.1*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"\
		+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"+0.9*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)"\
		 , 0.1*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"\
		+0.9*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)", "Jumlah Lapangan Usaha Nonformal (Pop)"\
		  )
	~	Pop
	~	@output directorate=KSE indicator=61
	|

