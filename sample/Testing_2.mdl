{UTF-8}
"Jumlah Tenaga Kerja Informal (Pop) [a]"= INTEG (
	Penambahan Jumlah Tenaga Kerja Informal-Pengurangan Jumlah Tenaga Kerja Informal,
		"Jumlah Penduduk (Pop)")
	~	Pop
	~	@output
	|

"Jumlah Penduduk (Pop)"=
	5000
	~	Pop
	~	@input min=0 max=10000 step=1
	|

Penambahan Jumlah Lapangan Usaha Jasa Rendah=
	"Jumlah Tenaga Kerja Formal (Pop)"*Spillover Lapangan Usaha Jasa Tinggi ke Jasa Rendah
	~	Pop
	~		|

Jumlah Lapangan Usaha Jasa Rendah= INTEG (
	Penambahan Jumlah Lapangan Usaha Jasa Rendah,
		50)
	~	Pop
	~		|

Jumlah Angkatan Kerja=
	"TOTAL Jumlah Tenaga Kerja (Pop)"+"Jumlah Pengangguran (Pop)"
	~	Pop
	~		|

"Jumlah Lapangan Kerja Informal u Tenaaga kerja BARU High Skilled (b) (Pop)"=
	Rasio XXB*Jumlah Lapangan Usaha Jasa Rendah
	~	Pop
	~		|

"Jumlah Lapangan Kerja Informal u Tenaga Kerja BARU Low Skilled (c) (Pop)"=
	Rasio YYC*Jumlah Lapangan Usaha Jasa Rendah
	~	Pop
	~		|

"Jumlah Konversi tenaga kerja BARU High Skilled menuju Informal (Pop)"=
	IF THEN ELSE( Rasio XB<1 , "Jumlah Tenaga Kerja BARU High Skilled/Pengangguran (Pop) [b]"\
		*Rasio XB , "Jumlah Tenaga Kerja BARU High Skilled/Pengangguran (Pop) [b]" )
	~	Pop
	~		|

Penambahan Jumlah Lapangan Usaha Jasa Tinggi=
	"Jumlah Perusahaan StartUp (Unit)"*"Multiplikasi StartUp (Pop/Unit)"+"Jumlah Perusahaan Korporasi (Unit)"\
		*"Multiplikasi Korporasi (Pop/Unit)"
	~	Pop
	~		|

"Jumlah konversi tenaga kerja BARU Low Skilled menuju Informal (Pop)"=
	IF THEN ELSE(Rasio YC<1, "Jumlah Tenaga Kerja BARU Low Skilled/Pengangguran (Pop) [c]"\
		*Rasio YC , "Jumlah Tenaga Kerja BARU Low Skilled/Pengangguran (Pop) [c]" )
	~	Pop
	~		|

Pengurangan Jumlah Tenaga Kerja BARU High Skilled=
	IF THEN ELSE(Rasio B<1, "Jumlah Tenaga Kerja BARU High Skilled/Pengangguran (Pop) [b]"\
		*(1-Rasio B) , "Jumlah Tenaga Kerja BARU High Skilled/Pengangguran (Pop) [b]"
	 )+IF THEN ELSE(Rasio XB<1, "Jumlah Tenaga Kerja BARU High Skilled/Pengangguran (Pop) [b]"\
		*(1-Rasio XB) , "Jumlah Tenaga Kerja BARU High Skilled/Pengangguran (Pop) [b]" )
	~	Pop
	~		|

Pengurangan Jumlah Tenaga Kerja BARU Low Skilled=
	IF THEN ELSE(Rasio C<1, "Jumlah Tenaga Kerja BARU Low Skilled/Pengangguran (Pop) [c]"\
		*(1-Rasio C) , "Jumlah Tenaga Kerja BARU Low Skilled/Pengangguran (Pop) [c]")+IF THEN ELSE\
		( Rasio YC<1 , "Jumlah Tenaga Kerja BARU Low Skilled/Pengangguran (Pop) [c]"*(1-Rasio YC\
		) , "Jumlah Tenaga Kerja BARU Low Skilled/Pengangguran (Pop) [c]" )
	~	Pop
	~		|

Spillover Lapangan Usaha Jasa Tinggi ke Jasa Rendah=
	5
	~	Pop
	~	@input min=0 max=20 step=5
	|

Persentase Pengangguran=
	"Jumlah Pengangguran (Pop)"/Jumlah Angkatan Kerja
	~	Dmnl
	~		|

Rasio XB=
	"Jumlah Lapangan Kerja Informal u Tenaaga kerja BARU High Skilled (b) (Pop)"/"Jumlah Tenaga Kerja BARU High Skilled/Pengangguran (Pop) [b]"
	~	Dmnl
	~		|

Rasio YC=
	"Jumlah Lapangan Kerja Informal u Tenaga Kerja BARU Low Skilled (c) (Pop)"/"Jumlah Tenaga Kerja BARU Low Skilled/Pengangguran (Pop) [c]"
	~	Dmnl
	~		|

Rasio YYC=
	0.3
	~	Dmnl
	~		|

Rasio XXB=
	0.7
	~	Dmnl
	~		|

"TOTAL Jumlah Tenaga Kerja (Pop)"=
	"Jumlah Tenaga Kerja Formall (Pop)"+"Jumlah Tenaga Kerja Informal (Pop)"
	~	Pop
	~		|

Penambahan Jumlah Tenaga Kerja Informal=
	"Jumlah Konversi tenaga kerja BARU High Skilled menuju Informal (Pop)"+"Jumlah konversi tenaga kerja BARU Low Skilled menuju Informal (Pop)"
	~	Pop
	~		|

Jumlah Lapangan Usaha Jasa Tinggi= INTEG (
	Penambahan Jumlah Lapangan Usaha Jasa Tinggi-Pengurangan Jumlah Lapangan Usaha Jasa Tinggi\
		,
		10)
	~	Pop
	~		|

