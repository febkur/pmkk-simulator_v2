	~	Dmnl
	~		|

Sisa Lapangan Kerja c=
	IF THEN ELSE(Rasio C>1, "Jumlah Lapangan Kerja Formal u Tenaga Kerja BARU Low Skilled (c) (Pop)"\
		*(1/Rasio C) , "Jumlah Lapangan Kerja Formal u Tenaga Kerja BARU Low Skilled (c) (Pop)"\
		 )
	~	Pop
	~		|

"Jumlah Lapangan Kerja Formal u Tenaga Kerja BARU High Skilled (b) (Pop)"=
	Jumlah Lapangan Usaha Jasa Tinggi*Rasio BB
	~	Pop
	~		|

"Jumlah Lapangan Kerja Formal u Tenaga Kerja BARU Low Skilled (c) (Pop)"=
	Jumlah Lapangan Usaha Jasa Tinggi*Rasio CC
	~	Pop
	~		|

"Jumlah Lapangan Kerja Formal u Tenaga Kerja Informal (a) (Pop)"=
	Jumlah Lapangan Usaha Jasa Tinggi*Rasio AA
	~	Pop
	~		|

Pengurangan Jumlah Lapangan Usaha Jasa Tinggi=
	Sisa Jumlah Lapangan Kerja a+Sisa Lapangan Kerja b+Sisa Lapangan Kerja c
	~	Pop
	~		|

Sisa Jumlah Lapangan Kerja a=
	IF THEN ELSE(RasioA>1, "Jumlah Lapangan Kerja Formal u Tenaga Kerja Informal (a) (Pop)"\
		*(1/RasioA) , "Jumlah Lapangan Kerja Formal u Tenaga Kerja Informal (a) (Pop)" )
	~	Pop
	~		|

Sisa Lapangan Kerja b=
	IF THEN ELSE(Rasio B>1, "Jumlah Lapangan Kerja Formal u Tenaga Kerja BARU High Skilled (b) (Pop)"\
		*(1/Rasio B) , "Jumlah Lapangan Kerja Formal u Tenaga Kerja BARU High Skilled (b) (Pop)"\
		 )
	~	Pop
	~		|

