{UTF-8}
"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"=
	"Proporsi Lulusan Pendidikan Tinggi(dmnl)"*"Jumlah Penduduk Usia Kerja (Pop)"
	~	Pop
	~		|

"Penambahan Jumlah Kelas Menengah (Pop)"=
	"Penyerapan Tenaga Kerja Formal (Pop)"
	~	Pop
	~		|

"Jumlah Lapangan Usaha Formal (Pop)"= INTEG (
	"Penambahan Jumlah Lapangan Kerja Formal (Pop)"*(1-"Cost of Compliance/Regulation + Investment Impediment +Uncertainty + Corruption (dmnl)"\
		),
		0)
	~	Pop
	~	@output directorate=Naker indicator=43
	|

"Pengurangan Penduduk Usia 0-15 Tahun (Pop)"=
	"Rate Perubahan Proporsi Usia 0-15 Tahun (dmnl)"*"Jumlah Penduduk Usia 0-15 Tahun (Pop)"
	~	Pop
	~		|

"Penyerapan Tenaga Kerja Formal (Pop)"=
	IF THEN ELSE( "Jumlah Lapangan Usaha Formal (Pop)">0.9*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"\
		+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"
	+0.1*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)" , 0.9*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"\
		+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"
	+0.1*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)" , "Jumlah Lapangan Usaha Formal (Pop)"\
		)
	~	Pop
	~	@output directorate=Naker indicator=42
	|

"Penyerapan Tenaga Kerja Informal (Pop)"=
	IF THEN ELSE( "Jumlah Lapangan Usaha Nonformal (Pop)">0.1*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"\
		+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"
+0.9*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)" , 0.1*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"\
		+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"
+0.9*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)", "Jumlah Lapangan Usaha Nonformal (Pop)"\
		  )
	~	Pop
	~	@output directorate=KSE indicator=61
	|

"Jumlah Penduduk Lansia (Pop)"= INTEG (
	"Penambahan Lansia (Pop)",
		"Proporsi Usia Lansia Awal (dmnl)"*"Jumlah Penduduk Total (Pop)")
	~	Pop
	~		|

"Penambahan Jumlah Lapangan Kerja Formal (Pop)"=
	"Jumlah Lapangan Kerja High Value Added Manufacturing (Pop)"+"Jumlah Lapangan Kerja High Value Added Service (Pop)"\
		+"Jumlah Lapangan Kerja dari Usaha Menengah (Pop)"+"Jumlah Lapangan Kerja dari Usaha Besar/Korporasi (Pop)"\
		+"Jumlah Lapangan Kerja dari Startup (Pop)"
	~	Pop
	~		|

"Proporsi Penciptaan Lapangan Kerja (dmnl)"=
	"Jumlah Lapangan Usaha Formal (Pop)"/("Jumlah Lapangan Usaha Formal (Pop)"+"Jumlah Lapangan Usaha Nonformal (Pop)"\
		)
	~	dmnl
	~	@output directorate=NAKER indicator=39
	|

"Penambahan Lansia (Pop)"=
	"Jumlah Penduduk Lansia (Pop)"*"Rate Perubahan Proporsi Lansia (dmnl)"
	~	Pop
	~		|

"Jumlah Penduduk Usia 0-15 Tahun (Pop)"= INTEG (
	-"Pengurangan Penduduk Usia 0-15 Tahun (Pop)",
		"Proporsi Usia 0-15 Tahun Awal (dmnl)"*"Jumlah Penduduk Total (Pop)")
	~	Pop
	~		|

"Jumlah Penduduk Usia Kerja (Pop)"= INTEG (
	-"Pengurangan Penduduk Lansia (Pop)",
		"Proporsi Usia Kerja Awal (dmnl)"*"Jumlah Penduduk Total (Pop)")
	~	Pop
	~		|

"Mobilitas Penduduk Penyandang Disabilitas (dmnl)"=
	"Jumlah Penyandang Disabilitas bekerja di sektor formal (Pop)"/"Jumlah Penduduk Usia Kerja (Pop)"
	~	dmnl
	~	@output directorate=PKKS indicator=4
	|

"Jumlah Penyandang Disabilitas bekerja di sektor formal (Pop)"=
	(8.5/100)*"Jumlah Penduduk Usia Kerja (Pop)"/("Penyerapan Tenaga Kerja Formal (Pop)"\
		+1)
	~	dmnl
	~	@output directorate=PKKS indicator=14
	|

"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"=
	"Proporsi Lulusan Pendidikan Menengah (dmnl)"*"Jumlah Penduduk Usia Kerja (Pop)"
	~	
	~		|

"Pengurangan Penduduk Lansia (Pop)"=
	"Jumlah Penduduk Usia Kerja (Pop)"*"Rate Perubahan Proporsi Usia Kerja (dmnl)"
	~	Pop
	~		|

"Pengurangan Jumlah Kelas Menengah (Pop)"=
	("Jumlah Kelas Menengah (Pop)"*"Inflasi (dmnl)")+"Jumlah Kelas Atas (Pop)"
	~	Pop
	~		|

"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)"=
	"Proporsi Lulusan Pendidikan Dasar (dmnl)"*"Jumlah Penduduk Usia Kerja (Pop)"
	~	Pop
	~		|

"Jumlah Pengangguran (Pop)"=
	"Jumlah Penduduk Usia Kerja (Pop)"-"Penyerapan Tenaga Kerja Formal (Pop)"-"Penyerapan Tenaga Kerja Informal (Pop)"
	~	Pop
	~	@output directorate=NAKER indicator=32
	|

"Jumlah Perusahaan yang memathui Norma Ketenagakerjaan (Unit)"=
	"Jumlah Usaha Besar Korporasi (Unit)"+"Jumlah Usaha Menengah (Unit)"
	~	Unit
	~	@output directorate=NAKER indicator=45
	|

Persentase PPU Jamsos Naker=
	"Penyerapan Tenaga Kerja Formal (Pop)"
	~	Pop
	~	@output directorate=NAKER indicator=50
	|

"Cakupan Jamsos Naker (Pop)"=
	"Penyerapan Tenaga Kerja Formal (Pop)"+0.2*"Penyerapan Tenaga Kerja Informal (Pop)"
	~	Pop
	~	@output directorate=KJS indicator=28
	|

Asumsi Kekayaan Kelas Atas dan Menengah=
	500000
	~	dmnl
	~		|

Asumsi Kekayaan Kelas Miskin dan Ekstrem=
	200000
	~	dmnl
	~		|

Jumlah Usaha Mikro dan Kecil=
	0.7*"Jumlah Working Poor (Pop)"
	~	Unit
	~	@output directorate=KUMKM indicator=52
	|

Laju Pertumbuhan PDB per Tenaga Kerja=
	"Jumlah PDB (Rp)"/("Penyerapan Tenaga Kerja Formal (Pop)"+"Penyerapan Tenaga Kerja Informal (Pop)"\
		)
	~	Rp/Pop
	~	@output directorate=Naker indicator=41
	|

"Jumlah PDB (Rp)"=
	"Jumlah PDB dari Lapangan Usaha Formal (Rp)"+"Jumlah PDB dari Lapangan Usaha Nonformal (Rp)"
	~	Rp
	~		|

"Jumlah PDB dari Lapangan Usaha Formal (Rp)"=
	"Rata-Rata PDB/Kapita Lapangan Usaha Formal (Rp/Pop)"*"Penyerapan Tenaga Kerja Formal (Pop)"
	~	Rp
	~		|

"Jumlah PDB dari Lapangan Usaha Nonformal (Rp)"=
	"Rata-rata PDB/Kapita Lapangan Usaha Nonformal (Rp/Pop)"*"Penyerapan Tenaga Kerja Informal (Pop)"
	~	Rp
	~		|

