"Jumlah Start Up (Unit)"=
	DELAY1( ("Jumlah Kelas Atas (Pop)"+"Jumlah Kelas Menengah (Pop)")*"Rasio Kewirausahaan (Unit/Pop)"\
		 , 1 )
