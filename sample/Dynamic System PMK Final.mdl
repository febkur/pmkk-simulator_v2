{UTF-8}
"Tingkat Kemiskinan Ekstrem (dmnl)"=
	"Jumlah Penduduk Miskin Ekstrem (Pop)"/"Jumlah Penduduk Total (Pop)"
	~	dmnl
	~	@output directorate=PKKS indicator=2
	|

"Proporsi Penduduk Kelas Menengah (dmnl)"=
	("Jumlah Working Poor (Pop)"+"Jumlah Kelas Menengah (Pop)"+"Jumlah Kelas Atas (Pop)"\
		)/"Jumlah Penduduk Total (Pop)"
	~	dmnl
	~	@output directorate=KJS indicator=25
	|

"Jumlah Pekerja tidak terserap Lapangan Kerja Formal (Pop)"=
	"Jumlah Penduduk Usia Kerja (Pop)"-"Penyerapan Tenaga Kerja Formal (Pop)"
	~	Pop
	~		|

"Tingkat Kemiskinan (dmnl)"=
	"Jumlah Penduduk Miskin (Pop)"/"Jumlah Penduduk Total (Pop)"
	~	dmnl
	~	@output directorate=PKKS indicator=1
	|

"Penyerapan Tenaga Kerja Informal (Pop)"=
	IF THEN ELSE( "Jumlah Lapangan Usaha Nonformal (Pop)"> "Jumlah Pekerja tidak terserap Lapangan Kerja Formal (Pop)"\
		, "Jumlah Pekerja tidak terserap Lapangan Kerja Formal (Pop)", "Jumlah Lapangan Usaha Nonformal (Pop)"\
		  )
	~	Pop
	~	@output directorate=KSE indicator=61
	|

"Proporsi Jumlah Usaha Kecil dan Menengah (dmnl)"=
	("Jumlah Usaha Mikro dan Kecil (Unit)"+"Jumlah Usaha Menengah (Unit)")/("Jumlah Usaha Mikro dan Kecil (Unit)"\
		+"Jumlah Usaha Menengah (Unit)"
	+"Jumlah Usaha Besar Korporasi (Unit)")
	~	dmnl
	~	@output directorate=KUMKM indicator=52
	|

"Indeks kesejahteraan sosial untuk penduduk lanjut usia (dmnl)"=
	"Mobilitas Penduduk Lanjut Usia (Pop)"
	~	Pop
	~	@output directorate=PKKS indicator=5
	|

"Mobilitas Penduduk Lanjut Usia (Pop)"=
	"Jumlah Penduduk Lansia (Pop)"*"Proporsi Penduduk Kelas Menengah (dmnl)"
	~	Pop
	~	@output directorate=PKKS indicator=3
	|

"Proporsi Pelaku Usaha dengan Usaha Berbadan Hukum atau Memiliki Catatan Pembukuan Lengkap (dmnl)"\
		=
	("Jumlah Usaha Besar Korporasi (Unit)"+"Jumlah Usaha Menengah (Unit)")/("Jumlah Usaha Mikro dan Kecil (Unit)"\
		+"Jumlah Usaha Menengah (Unit)"+"Jumlah Usaha Besar Korporasi (Unit)")
	~	dmnl
	~	@output directorate=KUMKM indicator=58
	|

"Tingkat Daya Saing (dmnl)"=
	0.1
	~	dmnl
	~	@input step=0.1
	|

"Jumlah Lapangan Kerja Low Value Added Primary (Pop)"=
	DELAY1( 25/100*"Investasi Sektor Primer (Rp)" , 1 )
	~	Pop
	~		|

"Jumlah Lapangan Kerja Low Value Added Service (Pop)"=
	DELAY1( 30/100*"Investasi Low Value Added Service (Rp)" + 3.3*"Jumlah Kelas Menengah (Pop)"\
		, 1 )
	~	Pop
	~		|

"Jumlah Lapangan Usaha Formal (Pop)"= INTEG (
	"Penambahan Jumlah Lapangan Kerja Formal (Pop)"-Pengurangan Jumlah Lapangan Kerja Formal\
		,
		0)
	~	Pop
	~	@output directorate=Naker indicator=43
	|

"Jumlah Lapangan Kerja Low Value Added Manufacturing (Pop)"=
	DELAY3( 20/100*"Investasi Low Value Added Manufacturing (Rp)" , 1.5 )
	~	Pop
	~		|

"Indeks kesejahteraan sosial untuk penyandang disabilitas (dmnl)"=
	"Mobilitas Penduduk Penyandang Disabilitas (dmnl)"
	~	dmnl
	~		|

"Rate Pengurangan Penyerapan Tenaga Kerja (dmnl)"=
	0.1
	~	dmnl
	~		|

"Proporsi UMKM yang Memiliki Izin Usaha (dmnl)"=
	"Jumlah Usaha Menengah (Unit)"/("Jumlah Usaha Mikro dan Kecil (Unit)"+"Jumlah Usaha Menengah (Unit)"\
		)
	~	dmnl
	~	@output directorate=KUMKM indicator=55
	|

"Jumlah Lapangan Kerja High Value Added Service (Pop)"=
	DELAY3( 10/100*"Investasi High Value Added Service (Rp)" , 1.5 )
	~	Pop
	~		|

"Penambahan Jumlah Lapangan Kerja Formal (Pop)"=
	"Jumlah Lapangan Kerja High Value Added Manufacturing (Pop)"+"Jumlah Lapangan Kerja High Value Added Service (Pop)"\
		+"Jumlah Lapangan Kerja dari Usaha Menengah (Pop)"
	+"Jumlah Lapangan Kerja dari Usaha Besar/Korporasi (Pop)"+"Jumlah Lapangan Kerja dari Startup (Pop)"
	~	Pop
	~		|

"Penyerapan Tenaga Kerja Formal (Pop)"=
	IF THEN ELSE( 0.9*"Jumlah Lapangan Usaha Formal (Pop)">0.9*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"\
		+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"+0.1*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)"\
		 , 0.9*"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"+0.5*"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"
	+0.1*"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)" , 0.9*"Jumlah Lapangan Usaha Formal (Pop)"\
		)
	~	Pop
	~	@output directorate=Naker indicator=42
	|

Pengurangan Jumlah Lapangan Kerja Formal=
	"Jumlah Lapangan Usaha Formal (Pop)"*(1+"Cost of Compliance/Regulation + Investment Impediment +Uncertainty + Corruption (dmnl)"
	+"Rate Pengurangan Penyerapan Tenaga Kerja (dmnl)"-"Tingkat Daya Saing (dmnl)")
	~	Pop
	~		|

"Jumlah Lapangan Kerja High Value Added Manufacturing (Pop)"=
	DELAY3( 15/100*"Investasi High Value Added Manufacturing (Rp)" , 1.5 )
	~	Pop
	~		|

"Persentase PBPU Jamsos Naker (dmnl)"=
	1-Persentase PPU Jamsos Naker
	~	dmnl
	~	@output directorate=NAKER indicator=49
	|

"Pengurangan Jumlah Kelas Menengah (Pop)"=
	("Jumlah Kelas Menengah (Pop)"*("Inflasi (dmnl)"+Kerawanan Bencana Alam dan Non Alam\
		))+"Jumlah Kelas Atas (Pop)"
	~	Pop
	~		|

"Jumlah Penyandang Disabilitas bekerja di sektor formal (Pop)"=
	IF THEN ELSE( 0.1*"Jumlah Lapangan Usaha Formal (Pop)">8.5/100*"Jumlah Penduduk Usia Kerja (Pop)"\
		 , 8.5/100*"Jumlah Penduduk Usia Kerja (Pop)" , 0.1*"Jumlah Lapangan Usaha Formal (Pop)"\
		 )
	~	dmnl
	~	@output directorate=PKKS indicator=14
	|

"Jumlah Usaha Mikro dan Kecil (Unit)"=
	0.7*"Jumlah Working Poor (Pop)"
	~	Unit
	~		|

Kerawanan Bencana Alam dan Non Alam=
	0.1
	~	dmnl
	~	@input min=0 max=1 step=0.05
	|

"Jumlah Tenaga Kerja Keterampilan Tinggi (Pop)"=
	"Proporsi Lulusan Pendidikan Tinggi(dmnl)"*"Jumlah Penduduk Usia Kerja (Pop)"
	~	Pop
	~		|

"Penambahan Jumlah Kelas Menengah (Pop)"=
	DELAY1( "Penyerapan Tenaga Kerja Formal (Pop)" , 2 )
	~	Pop
	~		|

"Pengurangan Penduduk Usia 0-15 Tahun (Pop)"=
	"Rate Perubahan Proporsi Usia 0-15 Tahun (dmnl)"*"Jumlah Penduduk Usia 0-15 Tahun (Pop)"
	~	Pop
	~		|

"Jumlah Penduduk Lansia (Pop)"= INTEG (
	"Penambahan Lansia (Pop)",
		"Proporsi Usia Lansia Awal (dmnl)"*"Jumlah Penduduk Total (Pop)")
	~	Pop
	~		|

"Proporsi Penciptaan Lapangan Kerja (dmnl)"=
	"Jumlah Lapangan Usaha Formal (Pop)"/("Jumlah Lapangan Usaha Formal (Pop)"+"Jumlah Lapangan Usaha Nonformal (Pop)"\
		)
	~	dmnl
	~	@output directorate=NAKER indicator=39
	|

"Penambahan Lansia (Pop)"=
	"Jumlah Penduduk Lansia (Pop)"*"Rate Perubahan Proporsi Lansia (dmnl)"
	~	Pop
	~		|

"Jumlah Penduduk Usia 0-15 Tahun (Pop)"= INTEG (
	-"Pengurangan Penduduk Usia 0-15 Tahun (Pop)",
		"Proporsi Usia 0-15 Tahun Awal (dmnl)"*"Jumlah Penduduk Total (Pop)")
	~	Pop
	~		|

"Jumlah Penduduk Usia Kerja (Pop)"= INTEG (
	-"Pengurangan Penduduk Usia Kerja (Pop)",
		"Proporsi Usia Kerja Awal (dmnl)"*"Jumlah Penduduk Total (Pop)")
	~	Pop
	~		|

"Mobilitas Penduduk Penyandang Disabilitas (dmnl)"=
	("Jumlah Penyandang Disabilitas bekerja di sektor formal (Pop)")/(8.5/100*"Jumlah Penduduk Usia Kerja (Pop)"\
		)
	~	dmnl
	~	@output directorate=PKKS indicator=4
	|

"Jumlah Tenaga Kerja Keterampilan Menengah (Pop)"=
	"Proporsi Lulusan Pendidikan Menengah (dmnl)"*"Jumlah Penduduk Usia Kerja (Pop)"
	~	
	~		|

"Pengurangan Penduduk Usia Kerja (Pop)"=
	"Jumlah Penduduk Usia Kerja (Pop)"*"Rate Perubahan Proporsi Usia Kerja (dmnl)"
	~	Pop
	~		|

"Jumlah Tenaga Kerja Keterampilan Rendah (Pop)"=
	"Proporsi Lulusan Pendidikan Dasar (dmnl)"*"Jumlah Penduduk Usia Kerja (Pop)"
	~	Pop
	~		|

"Tingkat Pengangguran Terbuka (dmnl)"=
	("Jumlah Penduduk Usia Kerja (Pop)"-"Penyerapan Tenaga Kerja Formal (Pop)"-"Penyerapan Tenaga Kerja Informal (Pop)"\
		)/"Jumlah Penduduk Usia Kerja (Pop)"
	~	dmnl
	~	@output directorate=NAKER indicator=32
	|

"Jumlah Perusahaan yang memathui Norma Ketenagakerjaan (Unit)"=
	"Jumlah Usaha Besar Korporasi (Unit)"+"Jumlah Usaha Menengah (Unit)"
	~	Unit
	~	@output directorate=NAKER indicator=45
	|

Persentase PPU Jamsos Naker=
	"Penyerapan Tenaga Kerja Formal (Pop)"
	~	Pop
	~	@output directorate=NAKER indicator=50
	|

"Cakupan Jamsos Naker (Pop)"=
	"Penyerapan Tenaga Kerja Formal (Pop)"+0.2*"Penyerapan Tenaga Kerja Informal (Pop)"
	~	Pop
	~	@output directorate=KJS indicator=28
	|

Asumsi Kekayaan Kelas Atas dan Menengah=
	500000
	~	dmnl
	~		|

Asumsi Kekayaan Kelas Miskin dan Ekstrem=
	200000
	~	dmnl
	~		|

Laju Pertumbuhan PDB per Tenaga Kerja=
	"Jumlah PDB (Rp)"/("Penyerapan Tenaga Kerja Formal (Pop)"+"Penyerapan Tenaga Kerja Informal (Pop)"\
		)
	~	Rp/Pop
	~	@output directorate=Naker indicator=41
	|

"Jumlah PDB (Rp)"=
	"Jumlah PDB dari Lapangan Usaha Formal (Rp)"+"Jumlah PDB dari Lapangan Usaha Nonformal (Rp)"
	~	Rp
	~		|

"Jumlah PDB dari Lapangan Usaha Formal (Rp)"=
	"Rata-Rata PDB/Kapita Lapangan Usaha Formal (Rp/Pop)"*"Penyerapan Tenaga Kerja Formal (Pop)"
	~	Rp
	~		|

"Jumlah PDB dari Lapangan Usaha Nonformal (Rp)"=
	"Rata-rata PDB/Kapita Lapangan Usaha Nonformal (Rp/Pop)"*"Penyerapan Tenaga Kerja Informal (Pop)"
	~	Rp
	~		|

